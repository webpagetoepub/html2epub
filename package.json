    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "fflate": "^0.8.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "knip": "^6.23.0",
    "prettier": "3.9.5",
